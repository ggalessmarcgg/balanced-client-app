{
  "expo": {
    "name": "Balanced",
    "slug": "balanced",
    "version": "1.0.0",
    "scheme": "balanced",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "it.joinbalanced.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "it",
        "CFBundleLocalizations": [
          "it"
        ]
      }
    },
    "android": {
      "package": "it.joinbalanced.app",
      "backgroundColor": "#FAF8F5",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/avvio-logo.png",
          "imageWidth": 161,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F5"
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Balanced usa il microfono per registrare il racconto della tua giornata e compilare il diario al posto tuo.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notifica-android.png",
          "color": "#347F75",
          "defaultChannel": "nutrizionista",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

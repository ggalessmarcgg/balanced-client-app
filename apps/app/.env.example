# Collegamento a Supabase (valori dalla dashboard del progetto, mai dal codice di altri repo).
# Copiare in .env (non versionato) e compilare. Per le build su EAS le stesse tre variabili stanno negli ambienti
# `preview` e `production` del progetto Expo (`eas env:list --environment production`), insieme alla variabile di tipo
# file GOOGLE_SERVICES_JSON (google-services.json di Firebase, anch'esso mai nel repo; letto da app.config.js).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server degli agenti dell'app (balanced-client-agents su Railway): indirizzo pubblico, non segreto.
EXPO_PUBLIC_AGENTI_URL=https://balanced-client-agents-production.up.railway.app

# Monitoraggio degli errori (Sentry, step 4): DSN del progetto balanced-app dell'organizzazione balanced-v3 (regione UE).
# Pubblico per natura (sta nel bundle), ma fuori dal repository come le altre. Negli ambienti `preview` e `production` di EAS.
# In sviluppo (__DEV__) il monitoraggio resta spento salvo EXPO_PUBLIC_SENTRY_IN_SVILUPPO=1 (solo per le prove sul Mac).
# Le mappe del codice le carica la build EAS con la variabile SEGRETA SENTRY_AUTH_TOKEN (token di organizzazione Sentry),
# che sta solo negli ambienti EAS: mai qui, mai nel .env.
EXPO_PUBLIC_SENTRY_DSN=
# Pagina di prova /sviluppo/monitoraggio anche nelle build di rilascio (=1): SOLO nell'ambiente EAS `preview`, mai in `production`.
# EXPO_PUBLIC_PAGINA_MONITORAGGIO=
# Ambiente dichiarato a Sentry dalle build di rilascio: `preview` SOLO nell'ambiente EAS `preview`; assente in `production`
# (= production). Così gli errori delle build di prova restano separati da quelli veri.
# EXPO_PUBLIC_SENTRY_AMBIENTE=

# Analisi dell'uso in modalità anonima (PostHog UE, step 4 lotto 2): chiave pubblica del progetto "Balanced app"
# (phc_…, sta nel bundle: non è un segreto, ma resta fuori dal repository). Negli ambienti `preview` e `production` di EAS.
# In sviluppo (__DEV__) l'analisi resta spenta salvo EXPO_PUBLIC_POSTHOG_IN_SVILUPPO=1 (solo per le prove sull'emulatore).
EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_IN_SVILUPPO=
